NODE_ENV=development
HOST=0.0.0.0
APP_ALLOWED_ORIGINS=http://localhost:5173
POSTGRES_USER=ci_app
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ci_platform
REDIS_PASSWORD=change-me-locally
RABBITMQ_DEFAULT_USER=ci_app
RABBITMQ_DEFAULT_PASS=change-me-locally
# reCAPTCHA v3: para desarrollo local puedes usar RECAPTCHA_ENABLED=false.
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
# En producción, usa los dominios exactos separados por comas (sin protocolo).
RECAPTCHA_ALLOWED_HOSTNAMES=localhost
# Login con Google. Vacío lo deja desactivado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
# SSO de Tickets. Debe ser exactamente el callback público de ci-tickets.
TICKETS_SSO_REDIRECT_URI=http://localhost:4201/auth/callback
MINIO_ROOT_USER=ci_minio
MINIO_ROOT_PASSWORD=change-me-locally
