generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/persistence/generated"
}

datasource db {
  provider = "postgresql"
}

/// Roles definidos por el manual; una identidad puede tener más de uno.
enum UserRoleName {
  STUDENT
  TEACHER
  ADVISOR
  DIRECTOR
  ADMINISTRATOR
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  LOCKED
}

enum IdentitySource {
  MANUAL
  INTRANET_SYNC
  IMPORT
}

enum IdentityDocumentType {
  DNI
  CE
  PASSPORT
}

/// Cuenta de autenticación. No contiene datos de perfil, académicos, grupos, matrículas ni pagos.
model User {
  id                  String               @id @default(uuid()) @db.Uuid
  username            String               @unique @db.VarChar(64)
  email               String               @unique @db.VarChar(254)
  passwordHash        String               @db.VarChar(255)
  status              UserStatus           @default(INVITED)
  source              IdentitySource       @default(MANUAL)
  emailVerifiedAt     DateTime?
  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  /// La cuenta debe definir una contraseña propia en el próximo inicio de sesión.
  mustChangePassword  Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  /// Sede del directorio administrativo. No representa matrícula ni grupo.
  siteId              String?              @db.Uuid
  profile             UserProfile?
  roles               UserRole[]
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  notifications       UserNotification[]
  grants              UserFunctionalityGrant[]
  auditEvents         AuditEvent[]

  @@index([status])
  @@index([siteId])
  @@map("users")
}

/// Datos generales editables desde la vista de perfil. El correo de acceso sigue en User.
model UserProfile {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @unique @db.Uuid
  documentType     IdentityDocumentType @default(DNI)
  documentNumber   String               @unique @db.VarChar(20)
  firstName        String               @db.VarChar(100)
  paternalLastName String               @db.VarChar(100)
  maternalLastName String?              @db.VarChar(100)
  phone            String?              @db.VarChar(30)
  mobileCountry    String?              @db.VarChar(6)
  mobile           String?              @db.VarChar(20)
  avatarObjectKey  String?              @db.VarChar(512)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paternalLastName, firstName])
  @@map("user_profiles")
}

/// RBAC explícito; evita codificar un único rol como una columna inflexible.
model UserRole {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  role       UserRoleName
  assignedAt DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

/// Sesión con refresh token opaco: se persiste solo su hash, nunca el token real.
model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(255)
  userAgent        String?   @db.VarChar(512)
  ipHash           String?   @db.VarChar(128)
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Recuperación de contraseña de un único uso; almacena hash y expiración, no el secreto enviado por correo.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Aviso dirigido a una cuenta. El id del evento es la clave de idempotencia.
model UserNotification {
  id            String    @id @db.Uuid
  userId        String    @db.Uuid
  title         String    @db.VarChar(120)
  body          String    @db.VarChar(500)
  correlationId String    @db.VarChar(64)
  createdAt     DateTime  @default(now())
  readAt        DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_notifications")
}

/// Catálogo administrativo por módulo. No reemplaza los permisos fijos que autorizan cada acción.
model PermissionDefinition {
  id              String                     @id @default(uuid()) @db.Uuid
  moduleCode      String                     @db.VarChar(64)
  name            String                     @db.VarChar(120)
  enabled         Boolean                    @default(true)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  deletedAt       DateTime?
  functionalities PermissionFunctionality[]

  @@index([moduleCode, deletedAt])
  @@map("permission_definitions")
}

model PermissionFunctionality {
  id           String               @id @default(uuid()) @db.Uuid
  permissionId String               @db.Uuid
  name         String               @db.VarChar(120)
  position     Int
  enabled      Boolean              @default(true)
  permission   PermissionDefinition @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([permissionId, position])
  @@unique([permissionId, name])
  @@map("permission_functionalities")
}

/// Catálogo de tipos de usuario para la pantalla de administración. No cambia los roles fijos que autorizan cada acción.
model UserTypeDefinition {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @db.VarChar(120)
  moduleCode  String               @db.VarChar(64)
  enabled     Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  permissions UserTypePermission[]
  modules     UserTypeModule[]

  @@index([deletedAt])
  @@map("user_type_definitions")
}

model UserTypeModule {
  id         String             @id @default(uuid()) @db.Uuid
  userTypeId String             @db.Uuid
  moduleCode String             @db.VarChar(64)
  enabled    Boolean            @default(true)
  position   Int
  userType   UserTypeDefinition @relation(fields: [userTypeId], references: [id], onDelete: Cascade)

  @@unique([userTypeId, moduleCode])
  @@unique([userTypeId, position])
  @@map("user_type_modules")
}

model UserTypePermission {
  id         String             @id @default(uuid()) @db.Uuid
  userTypeId String             @db.Uuid
  name       String             @db.VarChar(120)
  position   Int
  userType   UserTypeDefinition @relation(fields: [userTypeId], references: [id], onDelete: Cascade)

  @@unique([userTypeId, position])
  @@unique([userTypeId, name])
  @@map("user_type_permissions")
}

/// Funcionalidades asignadas en el alta de una cuenta. No reemplazan los permisos fijos del rol.
model UserFunctionalityGrant {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  permissionId      String  @db.Uuid
  functionalityName String  @db.VarChar(120)
  enabled           Boolean @default(true)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId, functionalityName])
  @@index([userId])
  @@map("user_functionality_grants")
}

/// Bitácora de acciones del sistema. Conserva el nombre y el rol aunque la cuenta cambie después.
model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  occurredAt DateTime @default(now())
  actorId    String?  @db.Uuid
  actorName  String   @db.VarChar(200)
  actorRole  String   @db.VarChar(32)
  module     String   @db.VarChar(40)
  action     String   @db.VarChar(240)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([actorRole])
  @@index([module])
  @@map("audit_events")
}
