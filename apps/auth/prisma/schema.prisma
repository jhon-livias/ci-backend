generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/persistence/generated"
}

datasource db {
  provider = "postgresql"
}

/// Roles definidos por el manual; una identidad puede tener más de uno.
enum UserRoleName {
  STUDENT
  TEACHER
  ADVISOR
  DIRECTOR
  ADMINISTRATOR
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  LOCKED
}

enum IdentitySource {
  MANUAL
  INTRANET_SYNC
  IMPORT
}

enum IdentityDocumentType {
  DNI
  CE
  PASSPORT
}

/// Cuenta de autenticación. No contiene datos de perfil, académicos, grupos, matrículas ni pagos.
model User {
  id                  String               @id @default(uuid()) @db.Uuid
  username            String               @unique @db.VarChar(64)
  email               String               @unique @db.VarChar(254)
  passwordHash        String               @db.VarChar(255)
  status              UserStatus           @default(INVITED)
  source              IdentitySource       @default(MANUAL)
  emailVerifiedAt     DateTime?
  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  profile             UserProfile?
  roles               UserRole[]
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]

  @@index([status])
  @@map("users")
}

/// Datos generales editables desde la vista de perfil. El correo de acceso sigue en User.
model UserProfile {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @unique @db.Uuid
  documentType     IdentityDocumentType @default(DNI)
  documentNumber   String               @unique @db.VarChar(20)
  firstName        String               @db.VarChar(100)
  paternalLastName String               @db.VarChar(100)
  maternalLastName String?              @db.VarChar(100)
  phone            String?              @db.VarChar(30)
  avatarObjectKey  String?              @db.VarChar(512)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paternalLastName, firstName])
  @@map("user_profiles")
}

/// RBAC explícito; evita codificar un único rol como una columna inflexible.
model UserRole {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  role       UserRoleName
  assignedAt DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

/// Sesión con refresh token opaco: se persiste solo su hash, nunca el token real.
model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(255)
  userAgent        String?   @db.VarChar(512)
  ipHash           String?   @db.VarChar(128)
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Recuperación de contraseña de un único uso; almacena hash y expiración, no el secreto enviado por correo.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
