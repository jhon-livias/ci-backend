generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/persistence/generated"
}

datasource db {
  provider = "postgresql"
}

enum StudentType {
  INTERNAL
  EXTERNAL
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

/// Alumno del Centro de Idiomas. userId referencia la identidad de auth, sin FK entre bases de datos.
model Student {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @unique @db.Uuid
  studentCode       String?       @unique @db.VarChar(32)
  type              StudentType
  status            StudentStatus @default(ACTIVE)
  intranetReference String?       @unique @db.VarChar(100)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  academicProfile   StudentAcademicProfile?

  @@index([type, status])
  @@map("students")
}

/// Solo aplica a alumnos internos; los externos no tienen facultad, escuela ni carrera.
model StudentAcademicProfile {
  id        String    @id @default(uuid()) @db.Uuid
  studentId String    @unique @db.Uuid
  facultyId String?   @db.Uuid
  schoolId  String?   @db.Uuid
  careerId  String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  faculty   Faculty?  @relation(fields: [facultyId], references: [id])
  school    School?   @relation(fields: [schoolId], references: [id])
  career    Career?   @relation(fields: [careerId], references: [id])

  @@map("student_academic_profiles")
}

model Faculty {
  id       String                   @id @default(uuid()) @db.Uuid
  code     String                   @unique @db.VarChar(32)
  name     String                   @db.VarChar(160)
  schools  School[]
  profiles StudentAcademicProfile[]

  @@map("faculties")
}

model School {
  id        String                   @id @default(uuid()) @db.Uuid
  facultyId String                   @db.Uuid
  code      String                   @unique @db.VarChar(32)
  name      String                   @db.VarChar(160)
  faculty   Faculty                  @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  careers   Career[]
  profiles  StudentAcademicProfile[]

  @@index([facultyId])
  @@map("schools")
}

model Career {
  id       String                   @id @default(uuid()) @db.Uuid
  schoolId String                   @db.Uuid
  code     String                   @unique @db.VarChar(32)
  name     String                   @db.VarChar(160)
  school   School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  profiles StudentAcademicProfile[]

  @@index([schoolId])
  @@map("careers")
}
