generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/persistence/generated"
}

datasource db {
  provider = "postgresql"
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

/// Sede académica. La ubicación puede registrarse cuando se confirme.
model Site {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(32)
  name      String    @db.VarChar(100)
  location  String?   @db.VarChar(255)
  department String?  @db.VarChar(100)
  province String?    @db.VarChar(100)
  district String?    @db.VarChar(100)
  street String?      @db.VarChar(255)
  postalCode String?  @db.VarChar(10)
  phone String?       @db.VarChar(30)
  email String?       @db.VarChar(254)
  contactName String? @db.VarChar(100)
  contactPhone String? @db.VarChar(30)
  districtCode String? @db.Char(7)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  geographicDistrict PeruDistrict? @relation(fields: [districtCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([active, deletedAt])
  @@map("sites")
}

/// Read-only official geographical catalog for Peru. Codes are preserved from
/// the supplied source dataset and never generated from labels.
model PeruDepartment {
  code      String         @id @db.Char(3)
  name      String         @db.VarChar(100)
  provinces PeruProvince[]

  @@map("peru_departments")
}

model PeruProvince {
  code           String          @id @db.Char(5)
  name           String          @db.VarChar(100)
  departmentCode String          @db.Char(3)
  department     PeruDepartment  @relation(fields: [departmentCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  districts      PeruDistrict[]

  @@index([departmentCode, name])
  @@map("peru_provinces")
}

model PeruDistrict {
  code         String       @id @db.Char(7)
  name         String       @db.VarChar(100)
  provinceCode String       @db.Char(5)
  province     PeruProvince @relation(fields: [provinceCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  sites        Site[]

  @@index([provinceCode, name])
  @@map("peru_districts")
}

/// Datos docentes mínimos. userId referencia la identidad de auth, sin FK entre microservicios.
model TeacherProfile {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @unique @db.Uuid
  teacherCode     String?       @unique @db.VarChar(32)
  academicDegree  String?       @db.VarChar(120)
  status          TeacherStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@map("teacher_profiles")
}

enum ClassKind {
  SYNCHRONOUS
  ASYNCHRONOUS
}

enum AcademicGroupKind {
  CLASSES
  PROFICIENCY
}

enum AcademicGroupStatus {
  CREATED
  RESCHEDULED
  OPENED
  COMPLETED
}

/// Combo de días y horas que el director arma para asignar a un grupo.
model ScheduleCombo {
  id        String         @id @default(uuid()) @db.Uuid
  number    Int            @unique
  createdAt DateTime       @default(now())
  slots     ScheduleSlot[]
  dayGroups AcademicGroup[] @relation("GroupDayCombo")
  hourGroups AcademicGroup[] @relation("GroupHourCombo")

  @@map("schedule_combos")
}

model ScheduleSlot {
  id           String       @id @default(uuid()) @db.Uuid
  comboId      String       @db.Uuid
  day          String       @db.VarChar(16)
  classKind    ClassKind
  startMinutes Int
  endMinutes   Int
  combo        ScheduleCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@index([comboId])
  @@map("schedule_slots")
}

model AcademicGroup {
  id               String              @id @default(uuid()) @db.Uuid
  code             String              @unique @db.VarChar(16)
  kind             AcademicGroupKind
  status           AcademicGroupStatus @default(CREATED)
  language         String              @db.VarChar(80)
  level            String              @db.VarChar(80)
  modality         String              @db.VarChar(80)
  studyType        String              @db.VarChar(80)
  meetUrl          String              @db.VarChar(255)
  startsAt         DateTime
  endsAt           DateTime
  teacherUserId    String              @db.Uuid
  teacherDocument  String              @db.VarChar(16)
  teacherName      String              @db.VarChar(200)
  dayComboId       String?             @db.Uuid
  hourComboId      String?             @db.Uuid
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  dayCombo         ScheduleCombo?      @relation("GroupDayCombo", fields: [dayComboId], references: [id], onDelete: Restrict)
  hourCombo        ScheduleCombo?      @relation("GroupHourCombo", fields: [hourComboId], references: [id], onDelete: Restrict)

  @@index([status, kind])
  @@map("academic_groups")
}

enum AcademicCatalogKind {
  LANGUAGE
  LEVEL
  STUDY_TYPE
  MODALITY
  GROUP_TYPE
}

/// Opciones que el administrador ofrece al director para armar grupos y matrículas.
model AcademicCatalogItem {
  id        String               @id @default(uuid()) @db.Uuid
  kind      AcademicCatalogKind
  name      String               @db.VarChar(80)
  position  Int
  createdAt DateTime             @default(now())
  deletedAt DateTime?

  @@index([kind, position])
  @@map("academic_catalog_items")
}

/// Una sola fila con las reglas que aplican a todos los grupos.
model AcademicRules {
  id                    String   @id @db.Uuid
  minStudents           Int
  maxStudents           Int
  absencePercent        Int
  passingGrade          Int
  evaluationsPerGroup   Int
  maxScorePerEvaluation Int
  updatedAt             DateTime @updatedAt

  @@map("academic_rules")
}
