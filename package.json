{
  "name": "ci-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/apps/gateway/src/main.js",
    "start:dev": "tsx watch apps/gateway/src/main.ts",
    "start:gateway:dev": "tsx watch apps/gateway/src/main.ts",
    "start:auth:dev": "tsx watch apps/auth/src/main.ts",
    "start:academic:dev": "tsx watch apps/academic/src/main.ts",
    "start:students:dev": "tsx watch apps/students/src/main.ts",
    "start:enrollment:dev": "tsx watch apps/enrollment/src/main.ts",
    "start:attendance-grades:dev": "tsx watch apps/attendance-grades/src/main.ts",
    "start:exams:dev": "tsx watch apps/exams/src/main.ts",
    "start:payments:dev": "tsx watch apps/payments/src/main.ts",
    "auth:db:generate": "prisma generate --config prisma.config.ts",
    "auth:db:validate": "prisma validate --config prisma.config.ts",
    "auth:db:migrate": "prisma migrate dev --config prisma.config.ts",
    "auth:db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "auth:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "students:db:generate": "prisma generate --config apps/students/prisma.config.ts",
    "students:db:validate": "prisma validate --config apps/students/prisma.config.ts",
    "students:db:migrate": "prisma migrate dev --config apps/students/prisma.config.ts",
    "students:db:migrate:deploy": "prisma migrate deploy --config apps/students/prisma.config.ts",
    "enrollment:db:generate": "prisma generate --config apps/enrollment/prisma.config.ts",
    "enrollment:db:validate": "prisma validate --config apps/enrollment/prisma.config.ts",
    "enrollment:db:migrate": "prisma migrate dev --config apps/enrollment/prisma.config.ts",
    "enrollment:db:migrate:deploy": "prisma migrate deploy --config apps/enrollment/prisma.config.ts",
    "academic:db:generate": "prisma generate --config apps/academic/prisma.config.ts",
    "academic:db:validate": "prisma validate --config apps/academic/prisma.config.ts",
    "academic:db:migrate": "prisma migrate dev --config apps/academic/prisma.config.ts",
    "academic:db:migrate:deploy": "prisma migrate deploy --config apps/academic/prisma.config.ts",
    "payments:db:generate": "prisma generate --config apps/payments/prisma.config.ts",
    "payments:db:validate": "prisma validate --config apps/payments/prisma.config.ts",
    "payments:db:migrate": "prisma migrate dev --config apps/payments/prisma.config.ts",
    "payments:db:migrate:deploy": "prisma migrate deploy --config apps/payments/prisma.config.ts",
    "attendance:db:generate": "prisma generate --config apps/attendance-grades/prisma.config.ts",
    "attendance:db:validate": "prisma validate --config apps/attendance-grades/prisma.config.ts",
    "attendance:db:migrate": "prisma migrate dev --config apps/attendance-grades/prisma.config.ts",
    "attendance:db:migrate:deploy": "prisma migrate deploy --config apps/attendance-grades/prisma.config.ts",
    "lint": "oxlint --type-aware apps/ libs/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/http-proxy": "^11.6.5",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.3.4",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "amqplib": "^2.2.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
