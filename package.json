{
  "name": "ci-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/apps/gateway/src/main.js",
    "start:dev": "tsx watch apps/gateway/src/main.ts",
    "start:gateway:dev": "tsx watch apps/gateway/src/main.ts",
    "start:auth:dev": "tsx watch apps/auth/src/main.ts",
    "start:academic:dev": "tsx watch apps/academic/src/main.ts",
    "start:students:dev": "tsx watch apps/students/src/main.ts",
    "start:enrollment:dev": "tsx watch apps/enrollment/src/main.ts",
    "start:attendance-grades:dev": "tsx watch apps/attendance-grades/src/main.ts",
    "start:exams:dev": "tsx watch apps/exams/src/main.ts",
    "start:payments:dev": "tsx watch apps/payments/src/main.ts",
    "lint": "oxlint --type-aware apps/ libs/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "tsx": "^4.20.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
