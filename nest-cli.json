{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/gateway",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "projects": {
    "gateway": { "type": "application", "root": "apps/gateway", "sourceRoot": "apps/gateway/src", "entryFile": "main" },
    "auth": { "type": "application", "root": "apps/auth", "sourceRoot": "apps/auth/src", "entryFile": "main" },
    "academic": { "type": "application", "root": "apps/language-center/academic", "sourceRoot": "apps/language-center/academic/src", "entryFile": "main" },
    "students": { "type": "application", "root": "apps/language-center/students", "sourceRoot": "apps/language-center/students/src", "entryFile": "main" },
    "enrollment": { "type": "application", "root": "apps/language-center/enrollment", "sourceRoot": "apps/language-center/enrollment/src", "entryFile": "main" },
    "attendance-grades": { "type": "application", "root": "apps/language-center/attendance-grades", "sourceRoot": "apps/language-center/attendance-grades/src", "entryFile": "main" },
    "exams": { "type": "application", "root": "apps/language-center/exams", "sourceRoot": "apps/language-center/exams/src", "entryFile": "main" },
    "payments": { "type": "application", "root": "apps/language-center/payments", "sourceRoot": "apps/language-center/payments/src", "entryFile": "main" },
    "tickets": { "type": "application", "root": "apps/tickets", "sourceRoot": "apps/tickets/src", "entryFile": "main" }
  }
}
